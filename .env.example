# ---------------------------------------------------------------------------
# 인증 (필수)
# https://openapi.kiwoom.com 에서 발급받은 앱키/시크릿키
# ---------------------------------------------------------------------------
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=

# ---------------------------------------------------------------------------
# 환경
# true  -> mockapi.kiwoom.com (모의투자)
# false -> api.kiwoom.com     (실거래)
# ---------------------------------------------------------------------------
KIWOOM_USE_MOCK=true

# ---------------------------------------------------------------------------
# 주문 안전장치
# ---------------------------------------------------------------------------

# 실거래 주문의 1차 관문. false면 KIWOOM_USE_MOCK=false 여도 주문이 차단됩니다.
# 2차 관문은 MCP 툴 인자 confirm=true 이며, 둘 다 있어야 실주문이 나갑니다.
KIWOOM_ALLOW_REAL_TRADING=false

# 1회 주문 금액 상한 (원). 시장가 주문은 현재가로 환산해 검사합니다.
KIWOOM_MAX_ORDER_AMOUNT=1000000

# 동일 주문(종목/수량/단가/유형) 중복 차단 시간 (초).
# 의도적인 분할매수는 툴 인자 force=true 로 우회합니다. 0이면 비활성화.
KIWOOM_DEDUP_WINDOW_SECONDS=60

# 주문 시도 기록 파일. 중복 감지가 프로세스 재시작 후에도 유지되게 합니다.
KIWOOM_ORDER_JOURNAL=.kiwoom_orders.jsonl

# 기본 거래소 구분: KRX / NXT / SOR
KIWOOM_DEFAULT_EXCHANGE=KRX

# ---------------------------------------------------------------------------
# 네트워크 (선택)
# ---------------------------------------------------------------------------
KIWOOM_CONNECT_TIMEOUT=5.0
KIWOOM_READ_TIMEOUT=30.0

# 조회 API의 최대 시도 횟수. 주문 API에는 적용되지 않습니다(중복 체결 방지).
KIWOOM_MAX_RETRIES=3
KIWOOM_RETRY_DELAY=1.0

# 토큰 만료 몇 초 전부터 미리 갱신할지
KIWOOM_TOKEN_EXPIRY_BUFFER=60
